    <Profile id="ARM_OPK" name="АРМ оператора паспортного контроля">
      <RequireSzi>SPR,CSP,VIPNET,KES,KLNAGENT</RequireSzi>
      <AvBasesMaxAgeDays>7</AvBasesMaxAgeDays>
      <PasswordMinLength>8</PasswordMinLength>
      <PasswordMaxAgeDays>180</PasswordMaxAgeDays>
      <LockoutThresholdMax>10</LockoutThresholdMax>
      <SecurityLogMinMB>64</SecurityLogMinMB>
      <EventLookbackDays>30</EventLookbackDays>
      <FailedLogonWarn>20</FailedLogonWarn>
      <InactivityMaxSec>900</InactivityMaxSec>
      <CertWarnDays>90</CertWarnDays>
      <RequireFirewall>true</RequireFirewall>
      <CrlWarnHours>24</CrlWarnHours>
      <InactiveUserDays>45</InactiveUserDays>
      <!-- Локальные учётные записи, допущенные к работе (пусто – сверка не выполняется) -->
      <AllowedUsers>
        <Account>Администратор*</Account>
        <Account>Administrator</Account>
      </AllowedUsers>
      <!-- Учётные записи, для которых допускается бессрочный пароль -->
      <PasswordNeverExpiresAllowed/>
      <AllowedAdmins>
        <Account>*\Администратор*</Account>
        <Account>*\Administrator</Account>
        <Account>*\Администраторы домена</Account>
        <Account>*\Domain Admins</Account>
        <Account>*\Администраторы безопасности</Account>
      </AllowedAdmins>
      <AuditPolicy>
        <Item name="Вход в систему" guid="{0CCE9215-69AE-11D9-BED3-505054503030}" value="3"/>
        <Item name="Выход из системы" guid="{0CCE9216-69AE-11D9-BED3-505054503030}" value="1"/>
        <Item name="Блокировка учётной записи" guid="{0CCE9217-69AE-11D9-BED3-505054503030}" value="2"/>
        <Item name="Управление учётными записями пользователей" guid="{0CCE9235-69AE-11D9-BED3-505054503030}" value="1"/>
        <Item name="Управление группами безопасности" guid="{0CCE9237-69AE-11D9-BED3-505054503030}" value="1"/>
