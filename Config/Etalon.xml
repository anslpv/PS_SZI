<?xml version="1.0" encoding="utf-8"?>
<!--
  Эталонный файл конфигурации ПО «СЗИ-Аудит».
  Заполняется администратором безопасности на основании предписания на эксплуатацию АСЗИ,
  спецификации СЗИ и эксплуатационной документации. Значения номеров сертификатов, сроков
  их действия, серийных номеров МНИ и отпечатков сертификатов УЦ приведены как пример
  и подлежат замене фактическими.
-->
<SziEtalon version="1.0" organization="Подразделение пограничного контроля" updated="2026-11-18">

  <Settings>
    <!-- Каталоги баз антивирусного средства (берётся дата самого нового файла) -->
    <AvBasesPath>%ProgramData%\Kaspersky Lab\KES\Bases</AvBasesPath>
    <AvBasesPath>%ProgramData%\Kaspersky Lab\KES.11.6.0\Bases</AvBasesPath>
    <AvBasesPath>%ProgramData%\Kaspersky Lab\KAVFSEE\10.0\Bases</AvBasesPath>
    <!-- Подразделение Active Directory, из которого по кнопке «Из домена…» загружается перечень АРМ.
         Пусто – весь домен. Пример: OU=Компьютеры в кабинах ПК,DC=ptk,DC=local -->
    <DomainSearchBase></DomainSearchBase>
    <!-- Журналы событий АВС, в которых ищутся обнаружения вредоносного ПО:
         eventIds – коды событий (необязательно), keywords – регулярное выражение по тексту события -->
    <AvLog name="Kaspersky Event Log" eventIds="" keywords="обнаружен|вредонос|заражен|detected|infected|malicious"/>
    <AvLog name="Microsoft-Windows-Windows Defender/Operational" eventIds="1116,1117" keywords=""/>
  </Settings>

  <!-- Справочник средств защиты информации -->
  <SziList>
    <Szi id="SPR" name="СЗИ от НСД «Secure Pack Rus»" productPattern="*Secure Pack Rus*"
         minVersion="3.0" servicePattern="" sziClass="АК3"
         certNumber="СФ/000-0000" certExpires="2028-12-31"/>
    <Szi id="CSP" name="СКЗИ «КриптоПро CSP»" productPattern="*КриптоПро CSP*|*CryptoPro CSP*"
         minVersion="5.0" servicePattern="" sziClass="КС3"
         certNumber="СФ/000-0001" certExpires="2028-12-31"/>
    <Szi id="VIPNET" name="ПК «ViPNet Client 4»" productPattern="*ViPNet Client*"
         minVersion="4.5" servicePattern="*ViPNet*" sziClass="КС3"
         certNumber="СФ/000-0002" certExpires="2028-12-31"/>
    <Szi id="KES" name="АВС «Kaspersky Endpoint Security для Windows»" productPattern="Kaspersky Endpoint Security*"
         minVersion="11.6" servicePattern="AVP*" sziClass="Б2, В2, Г2"
         certNumber="СФ/000-0003" certExpires="2028-12-31"/>
    <Szi id="KSWS" name="АВС «Kaspersky Security для Windows Server»" productPattern="Kaspersky Security*Windows Server*"
         minVersion="10.2" servicePattern="kavfs*" sziClass="Б2"
         certNumber="СФ/000-0004" certExpires="2028-12-31"/>
    <Szi id="KLNAGENT" name="Агент администрирования Kaspersky Security Center"
         productPattern="*Агент администрирования Kaspersky*|*Kaspersky Security Center*Network Agent*"
         minVersion="13.0" servicePattern="klnagent" sziClass="—"
         certNumber="" certExpires=""/>
  </SziList>

  <!-- Разрешённое ПО (предписание на эксплуатацию), общее для всех профилей -->
  <AllowedSoftware>
    <Pattern>Microsoft Visual C++*</Pattern>
    <Pattern>Microsoft .NET*</Pattern>
    <Pattern>*Рутокен*|*Rutoken*</Pattern>
    <Pattern>*Update for*</Pattern>
    <Pattern>*(KB*)*</Pattern>
    <Pattern>*МСПВ*</Pattern>
  </AllowedSoftware>

  <!-- Профили АРМ (типы рабочих мест) -->
