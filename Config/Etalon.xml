  <!-- Службы, которые должны быть отключены (неиспользуемые функциональные возможности) -->
  <ForbiddenServices>
    <Service name="RemoteRegistry" title="Удалённый реестр"/>
    <Service name="TlntSvr" title="Telnet"/>
    <Service name="RemoteAccess" title="Маршрутизация и удалённый доступ"/>
    <Service name="SharedAccess" title="Общий доступ к подключению к Интернету"/>
    <Service name="bthserv" title="Служба поддержки Bluetooth"/>
    <Service name="lfsvc" title="Служба географического положения"/>
    <Service name="WMPNetworkSvc" title="Служба общих сетевых ресурсов проигрывателя Windows Media"/>
    <Service name="Fax" title="Факс"/>
  </ForbiddenServices>

  <!-- Списки отозванных сертификатов: файлы .crl (допускаются маски) и/или СОС,
       установленные в системные хранилища Root и CA -->
  <Crls includeSystemStore="true">
    <Path>C:\CRL\*.crl</Path>
  </Crls>

  <!-- Учтённые съёмные машинные носители информации (журнал учёта МНИ) -->
  <Media>
    <Device serial="0401396BBFE2A1B5" owner="Администратор безопасности" note="МНИ уч. № 1 (пример)"/>
    <Device serial="AA00000000012345" owner="Старший смены" note="МНИ уч. № 2 (пример)"/>
  </Media>

  <!-- Сертификаты удостоверяющих центров, наличие которых контролируется.
